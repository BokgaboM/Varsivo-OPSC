<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="150dp"
    android:layout_marginBottom="16dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/bursaries_background" />

        <View
            android:id="@+id/tintOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/varsivo_card_blue_tint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/closingDateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/white"
                android:textSize="14sp"
                tools:text="31 May"
                xmlns:tools="http://schemas.android.com/tools" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/closesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="15sp"
                tools:text="Closes"
                xmlns:tools="http://schemas.android.com/tools" />

            <TextView
                android:id="@+id/bursaryNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/varsivo_navy"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="NSFAS"
                xmlns:tools="http://schemas.android.com/tools" />
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
