<?xml version="1.0" encoding="utf-8"?>
<!-- Navigation graph: every screen of the app is a Fragment destination. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.varsivo.ui.SplashFragment"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splash_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.varsivo.ui.LoginFragment"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.varsivo.ui.RegisterFragment"
        tools:layout="@layout/fragment_register" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.varsivo.ui.HomeFragment"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/bursariesFragment"
        android:name="com.example.varsivo.ui.BursariesFragment"
        tools:layout="@layout/fragment_bursaries" />

    <fragment
        android:id="@+id/bursaryDetailsFragment"
        android:name="com.example.varsivo.ui.BursaryDetailsFragment"
        tools:layout="@layout/fragment_bursary_details" />

    <fragment
        android:id="@+id/applicationFormFragment"
        android:name="com.example.varsivo.ui.ApplicationFormFragment"
        tools:layout="@layout/fragment_application_form" />

    <fragment
        android:id="@+id/applicationsTrackerFragment"
        android:name="com.example.varsivo.ui.ApplicationsTrackerFragment"
        tools:layout="@layout/fragment_applications_tracker" />

    <fragment
        android:id="@+id/universitiesFragment"
        android:name="com.example.varsivo.ui.UniversitiesFragment"
        tools:layout="@layout/fragment_universities" />

    <fragment
        android:id="@+id/universityMapFragment"
        android:name="com.example.varsivo.ui.UniversityMapFragment"
        tools:layout="@layout/fragment_university_map" />

    <fragment
        android:id="@+id/exploreFragment"
        android:name="com.example.varsivo.ui.ExploreFragment"
        tools:layout="@layout/fragment_explore" />

    <fragment
        android:id="@+id/firstYearSupportFragment"
        android:name="com.example.varsivo.ui.FirstYearSupportFragment"
        tools:layout="@layout/fragment_first_year_support" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.varsivo.ui.SettingsFragment"
        tools:layout="@layout/fragment_settings">
        <!-- Logging out clears the back stack and returns to the login screen -->
        <action
            android:id="@+id/action_settings_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
