<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Material 3 theme for the XML / Android Views UI. Layouts use Material components
         (TextInputLayout, MaterialButton, MaterialCardView...), which REQUIRE a Material theme. -->
    <style name="Theme.Varsivo" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/varsivo_navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/varsivo_gold</item>
        <item name="colorOnSecondary">@color/varsivo_navy</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/varsivo_text</item>
        <item name="colorError">@color/varsivo_error</item>

        <!-- Shown while the app starts (before the splash Fragment appears) -->
        <item name="android:windowBackground">@drawable/splash_background</item>

        <!-- The app draws edge-to-edge: the navy root layout shows through the (transparent) system
             bars, so keep the status-bar icons white. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
